PORT=3000
DATABASE_URL=postgresql://app:change-me@localhost:5432/app
DB_NAME=app
# Orígenes permitidos en producción (separados por coma, sin barra final).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
HTTP_RATE_WINDOW_MS=60000
HTTP_RATE_MAX=300
AUTH_RATE_MAX=20
# Ajustar solo si hay un proxy de confianza delante.
TRUST_PROXY_HOPS=
# Defínelos antes de producción: con NODE_ENV=production se rechaza un JWT_SECRET débil.
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-123
